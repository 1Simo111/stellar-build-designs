<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule ^$ dist/index.html [L]

  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule ^index\.html$ dist/index.html [L]

  # If the project root is deployed by mistake, serve files from the Vite build.
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
  RewriteRule ^(.+)$ dist/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . dist/index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
</IfModule>
